PORT=5000
DATABASE_URL="postgresql://user:password@localhost:5432/templatestore?schema=public"
MONGO_URI="mongodb+srv://user:password@cluster.mongodb.net/templatestore"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="your_jwt_secret_key"
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"
CLIENT_URL="http://localhost:3000"

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=yourgmail@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM="TemplateStore <no-reply@templatestore.com>"

# Cloudinary
CLOUDINARY_CLOUD_NAME=xxx
CLOUDINARY_API_KEY=xxx
CLOUDINARY_API_SECRET=xxx

# Payment
PAYSTACK_SECRET_KEY=your_paystack_secret_key
